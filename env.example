# ==========================
# Banco de Dados - PostgreSQL (padrão)
# ==========================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=the_blog

# ⚠️ IMPORTANTE: em produção, DB_SYNCHRONIZE deve ser "0" (desativado)
# Evita que o TypeORM apague ou modifique suas tabelas automaticamente
DB_SYNCHRONIZE=0

# Carrega as entidades automaticamente
DB_AUTO_LOAD_ENTITIES=1

# Tamanho máximo permitido para o upload de imagens (em bytes)
IMAGE_MAX_UPLOAD_SIZE=921600

# Tipos MIME de imagem permitidos no upload
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif

# ==========================
# Cloudinary (armazenamento de imagens)
# ==========================
# Informações do painel do usuário no Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================
# JWT (Autenticação)
# ==========================
# Chave secreta usada para assinar os tokens JWT.
# Em produção, use uma string longa e aleatória.
JWT_SECRET=your_jwt_secret

# Tempo de expiração dos tokens (em segundos)
JWT_EXPIRATION=86400

# ==========================
# Porta da aplicação
# ==========================
# Porta usada pelo NestJS no ambiente local
APP_PORT=3001

# ==========================
# Whitelist para o CORS separado por espaço
# ==========================
CORS_WHITELIST="http://localhost:3000 https://your-domain.com"

# Nome do cookie de sessão de login
LOGIN_COOKIE_NAME="loginSesion"

# Tempo de expiração dos tokens (em milissegundos)
JWT_EXPIRES_IN_MS=86400000
