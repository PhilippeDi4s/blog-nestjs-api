Authorization: Bearer {{adminToken}}


# ==================================================
# FIND MANY - USERS
# ==================================================

# Basic: all users
### @name findAllUsers
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### Filter by ID
# @name findUserById
GET {{baseUrl}}/admin/users?id={{userId}}
Authorization: Bearer {{adminToken}}

### Filter by email
# @name findUserByEmail
GET {{baseUrl}}/admin/users?email={{userEmailForTesting}}
Authorization: Bearer {{adminToken}}

### Filter by name
# @name findUserByName
GET {{baseUrl}}/admin/users?name={{userNameForTesting}}
Authorization: Bearer {{adminToken}}

### Filter by force logout status
# @name findUsersWithForceLogout
GET {{baseUrl}}/admin/users?forceLogout=true
Authorization: Bearer {{adminToken}}

### Filter by blocked status - true
# @name findBlockedUsers
GET {{baseUrl}}/admin/users?isBlocked=true
Authorization: Bearer {{adminToken}}

### Filter by blocked status - false
# @name findActiveUsers
GET {{baseUrl}}/admin/users?isBlocked=false
Authorization: Bearer {{adminToken}}

### Pagination: page 1
# @name findUsersPage1
GET {{baseUrl}}/admin/users?page=1&limit=10
Authorization: Bearer {{adminToken}}

### Pagination: page 2
# @name findUsersPage2
GET {{baseUrl}}/admin/users?page=2&limit=10
Authorization: Bearer {{adminToken}}

### Combined filters: blocked users with custom limit
# @name findBlockedUsersLimited
GET {{baseUrl}}/admin/users?isBlocked=true&limit=5
Authorization: Bearer {{adminToken}}

### Invalid page value
# @name findUsersInvalidPage
GET {{baseUrl}}/admin/users?page=0
Authorization: Bearer {{adminToken}}

### Invalid limit value
# @name findUsersInvalidLimit
GET {{baseUrl}}/admin/users?limit=0
Authorization: Bearer {{adminToken}}

### Limit exceeding maximum
# @name findUsersLimitTooHigh
GET {{baseUrl}}/admin/users?limit=150
Authorization: Bearer {{adminToken}}


