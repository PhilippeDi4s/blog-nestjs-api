# ==================================================
# VARIABLES
# ==================================================

@baseUrl = http://localhost:3001

# User test data
@userNameForTesting = João Silva
@userEmailForTesting = joao.silva@example.com
@userPasswordForTesting = senha123
@userNewPasswordForTesting = novaSenha456

# Admin test data
@adminEmailForTesting = ADCIONE_EMAIL_DO_ENV
@adminPasswordForTesting = ADCIONE_SENHA_DO_ENV

# Tokens and IDs (to be populated dynamically)
@userToken = {{loginUser.response.body.accessToken}}
@userId = {{createUser.response.body.id}}

@adminToken = {{loginAdmin.response.body.accessToken}}

@imageId = {{uploadImage.response.body.id}}
@imageUrl = {{uploadImage.response.body.url}}

@postId = {{createPost.response.body.id}}
@postSlug = {{createPost.response.body.slug}}


# ==================================================
# USER - AUTH
# ==================================================

# @name createUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "{{userNameForTesting}}",
  "email": "{{userEmailForTesting}}",
  "password": "{{userPasswordForTesting}}"
}

### Capture user ID from response
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmailForTesting}}",
  "password": "{{userPasswordForTesting}}"
}
###
# @name logoutUser
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}
###

# ==================================================
# USER - PROFILE
# ==================================================

# @name getCurrentUser
GET {{baseUrl}}/user/me
Authorization: Bearer {{userToken}}

### @name updateCurrentUser
PATCH {{baseUrl}}/user/me
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "João Silva Atualizado"
}

### @name updatePassword
PATCH {{baseUrl}}/user/me/password
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "currentPassword": "{{userPasswordForTesting}}",
  "newPassword": "{{userNewPasswordForTesting}}"
}

### Test: Update password with invalid current password
# @name updatePasswordInvalid
PATCH {{baseUrl}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "currentPassword": "senhaErrada123",
  "newPassword": "outraSenha789"
}
###

# ==================================================
# USER - UPLOAD
# ==================================================

# @name uploadImage
POST {{baseUrl}}/upload
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="image.png"
Content-Type: image/png

< ./dev/images/image.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--
###

# ==================================================
# USER - IMAGES
# ==================================================

# @name getMyImages
GET {{baseUrl}}/images/me
Authorization: Bearer {{userToken}}

### @name getImageById
GET {{baseUrl}}/images/{{imageId}}
Authorization: Bearer {{userToken}}

### @name deleteImage
DELETE {{baseUrl}}/images/{{imageId}}
Authorization: Bearer {{userToken}}
###

# ==================================================
# USER - POSTS
# ==================================================

# @name createPost
POST {{baseUrl}}/post/me
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Introdução ao NestJS - Um Framework Excelente",
  "excerpt": "Neste artigo, exploraremos os fundamentos do NestJS e como começar sua jornada.",
  "content": "O NestJS é um framework Node.js baseado no Express que oferece uma arquitetura modular e escalável. Vamos explorar seus principais conceitos, padrões de design, e como construir aplicações robustas.",
  "coverImage": "{{imageUrl}}",
  "published": false
}

### @name getMyPosts
GET {{baseUrl}}/post/me
Authorization: Bearer {{userToken}}

### @name getMyPostById
GET {{baseUrl}}/post/me/{{postId}}
Authorization: Bearer {{userToken}}

### @name updateMyPost
PATCH {{baseUrl}}/post/me/{{postId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Introdução ao NestJS - Framework Moderno e Poderoso",
  "excerpt": "Uma exploração profunda dos fundamentos do NestJS.",
  "published": true
}

### @name deleteMyPost
DELETE {{baseUrl}}/post/me/{{postId}}
Authorization: Bearer {{userToken}}

### Public: Get all published posts
# @name getAllPublishedPosts
GET {{baseUrl}}/post

### Public: Get post by slug
# @name getPostBySlug
GET {{baseUrl}}/post/{{postSlug}}

# ==================================================
# ADMIN - AUTH
# ==================================================
### @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmailForTesting}}",
  "password": "{{adminPasswordForTesting}}"
}


# ==================================================
# ADMIN - USERS
# ==================================================

### @name adminFindManyUsers
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### Find users with filter
# @name adminFindUsersByName
GET {{baseUrl}}/admin/users?name=João
Authorization: Bearer {{adminToken}}

### Find users paginated
# @name adminFindUsersPaginated
GET {{baseUrl}}/admin/users?page=1&limit=10
Authorization: Bearer {{adminToken}}

### Find blocked users
# @name adminFindBlockedUsers
GET {{baseUrl}}/admin/users?isBlocked=true
Authorization: Bearer {{adminToken}}

### @name adminUpdateUser
PATCH {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "João Silva - Atualizado pelo Admin",
  "reason": "Atualização de dados do usuário realizada conforme solicitação gerencial e auditoria operacional."
}

### @name adminPromoteUser
PATCH {{baseUrl}}/admin/users/{{userId}}/promote
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Promoção para admin realizada devido à comprovada capacidade gerencial e confiabilidade operacional."
}

### @name adminDemoteUser
PATCH {{baseUrl}}/admin/users/{{userId}}/demote
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Rebaixamento de permissões realizado conforme política de gestão de acessos e auditoria de segurança."
}

### @name adminBlockUser
PATCH {{baseUrl}}/admin/users/{{userId}}/block
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Bloqueio de conta realizado devido a violação de termos de serviço e comportamento suspeito identificado."
}

### @name adminUnblockUser
PATCH {{baseUrl}}/admin/users/{{userId}}/unblock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Desbloqueio de conta realizado após verificação de cumprimento de políticas e resolução de infrações."
}

### @name adminRestoreUser
PATCH {{baseUrl}}/admin/users/{{userId}}/restore
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Restauração de conta realizada conforme solicitação do usuário e revisão gerencial de elegibilidade."
}

### @name adminDeleteUser
DELETE {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Exclusão permanente de conta realizada por decisão administrativa após análise de conformidade e regulamentações."
}


# ==================================================
# ADMIN - AUTH / FORCE LOGOUT
# ==================================================

### @name adminForceLogout
POST {{baseUrl}}/auth/admin/{{userId}}/logout
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Logout forçado realizado como medida de segurança por atividade suspeita detectada no sistema."
}

### @name adminRevokeForceLogout
POST {{baseUrl}}/auth/admin/{{userId}}/revoke-logout
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Revogação de logout forçado realizada após resolução de incidente de segurança e liberação autorizada."
}


# ==================================================
# ADMIN - POSTS
# ==================================================

### @name adminFindManyPosts
GET {{baseUrl}}/admin/posts
Authorization: Bearer {{adminToken}}

### Find posts with filter
# @name adminFindPostsByTitle
GET {{baseUrl}}/admin/posts?title=NestJS
Authorization: Bearer {{adminToken}}

### Find published posts only
# @name adminFindPublishedPosts
GET {{baseUrl}}/admin/posts?published=true
Authorization: Bearer {{adminToken}}

### Find posts paginated
# @name adminFindPostsPaginated
GET {{baseUrl}}/admin/posts?page=1&limit=10
Authorization: Bearer {{adminToken}}

### @name adminUpdatePost
PATCH {{baseUrl}}/admin/posts/{{postId}}/update
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Título do Post Revisado Administrativamente",
  "excerpt": "Excerto revisado pelo administrador",
  "content": "Conteúdo revisado e atualizado conforme políticas editoriais",
  "reason": "Atualização administrativa realizada para conformidade com padrões editoriais e política de conteúdo."
}

### @name adminRestorePost
PATCH {{baseUrl}}/admin/posts/{{postId}}/restore
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Restauração de post realizada após solicitação do autor e revisão de conformidade editorial."
}

### @name adminDeletePost
DELETE {{baseUrl}}/admin/posts/0d2b01b1-4eca-4c6e-aa8e-a60bd319dbcf
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "{{adminPasswordForTesting}}",
  "reason": "Exclusão de post realizada por violação de política de conteúdo e revisão de conformidade editorial."
}


