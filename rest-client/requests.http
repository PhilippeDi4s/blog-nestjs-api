@baseUrl = http://localhost:3001

########################################
# Global test credentials (editable)
########################################
@userNameForTesting = João Silva
@userEmailForTesting = joao@example.com
@userPasswordForTesting = 123456
@userNewPasswordForTesting = 1234589

@adminEmailForTesting = admin@example.com
@adminPasswordForTesting = admin123
@targetUserEmailForTesting = target@example.com
@targetUserPasswordForTesting = targetpass

# Tokens - derived from login requests below when possible
# NOTE: the backend sets an httpOnly cookie on /auth/login. If /auth/login does not return an accessToken in the response body,
# set these values manually before running the requests (or adjust the backend to return the token in the response body).
@userToken = {{authLogin.response.body.accessToken}}
@adminToken = {{authAdminLogin.response.body.accessToken}}

# Resource variables (populated by preparatory requests)
@userId = {{readOneUser.response.body.id}}
@postUuid = {{createPostOwned.response.body.id}}
@postSlug = {{createPostOwned.response.body.slug}}
@targetPostId = {{createPostOwned.response.body.id}}
@imagePath = {{uploadImage.response.body.url}}
@imageUrl = {{baseUrl}}{{imagePath}}
@imageUuid = {{uploadImage.response.body.image_id}}
@targetImageId = {{uploadImage.response.body.image_id}}
@targetUserId = {{prepareCreateTargetUser.response.body.id}}


# ==================================================
# AUTH
# ==================================================

### Login (user)
# @name authLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmailForTesting}}",
  "password": "{{userPasswordForTesting}}"
}

### Login (admin)
# @name authAdminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmailForTesting}}",
  "password": "{{adminPasswordForTesting}}"
}

### Logout (user)
# @name authLogout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}


### Force logout (admin) - admin forces target user to logout
# @name authAdminForceLogout
POST {{baseUrl}}/auth/admin/logout/{{targetUserId}}
Authorization: Bearer {{adminToken}}


# ==================================================
# USER - public and authenticated flows
# ==================================================

### Create user (success)
# @name createUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "{{userNameForTesting}}",
  "email": "{{userEmailForTesting}}",
  "password": "{{userPasswordForTesting}}"
}

### Create user (missing password) -> validation error
# @name createUserMissingPassword
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "{{userNameForTesting}}",
  "email": "{{userEmailForTesting}}"
}

### Read current user (authenticated)
# @name readOneUser
GET {{baseUrl}}/user/me
Authorization: Bearer {{userToken}}

### Update current user (success)
# @name updateUser
PATCH {{baseUrl}}/user/me
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "{{userNameForTesting}} Edited",
  "email": "{{userEmailForTesting}}"
}

### Update password (success)
# @name updateUserPassword
PATCH {{baseUrl}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "currentPasswordHash": "{{userPasswordForTesting}}",
  "newPasswordHash": "{{userNewPasswordForTesting}}"
}

### Update password (invalid current password)
# @name updateUserPasswordInvalid
PATCH {{baseUrl}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "currentPasswordHash": "wrongpass",
  "newPasswordHash": "{{userNewPasswordForTesting}}"
}

### Delete current user (destructive - run last)
# @name deleteOneUser
DELETE {{baseUrl}}/user/me
Authorization: Bearer {{userToken}}


# ==================================================
# POST - create / read / update / delete
# ==================================================

### Create post (success) - prepares postUuid / postSlug
# @name createPostOwned
POST {{baseUrl}}/post/me
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Título do post",
  "excerpt": "Excerto para testes",
  "content": "Conteúdo de teste",
  "coverImage": "https://res.cloudinary.com/dqixnu2tr/image/upload/v1786474915/2026-08-11/1786474934393-72ka8x.webp"
}

### Create post (invalid body - missing title)
# @name createPostInvalid
POST {{baseUrl}}/post/me
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "excerpt": "Excerto",
  "content": "Conteúdo"
}

### Read all public posts
# @name readAllPostPublic
GET {{baseUrl}}/post/

### Read one public post (by slug)
# @name readOnePostPublic
GET {{baseUrl}}/post/{{postSlug}}

### Read all owned posts
# @name readAllPostOwned
GET {{baseUrl}}/post/me
Authorization: Bearer {{userToken}}

### Read one owned post (by id)
# @name readOnePostOwned
GET {{baseUrl}}/post/me/{{postUuid}}
Authorization: Bearer {{userToken}}

### Update owned post (success)
# @name updateOnePostOwned
PATCH {{baseUrl}}/post/me/{{postUuid}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "NOVO - Título do post",
  "excerpt": "NOVO - Excerto",
  "content": "NOVO - Conteúdo",
  "published": true
}

### Update owned post (not found)
# @name updateOnePostOwnedNotFound
PATCH {{baseUrl}}/post/me/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "NOVO",
  "excerpt": "NOVO",
  "content": "NOVO"
}

### Delete owned post (destructive - run after verification)
# @name deleteOnePostOwned
DELETE {{baseUrl}}/post/me/{{postUuid}}
Authorization: Bearer {{userToken}}


# ==================================================
# UPLOAD / IMAGES
# ==================================================

### Upload Image (multipart) - prepares @imageUuid and @imagePath
# @name uploadImage
POST {{baseUrl}}/upload
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=----RESTCLIENTBOUNDARY

------RESTCLIENTBOUNDARY
Content-Disposition: form-data; name="file"; filename="image.png"
Content-Type: image/png

< ../dev/images/image.jpeg
------RESTCLIENTBOUNDARY--

### Find one image (by id)
# @name findOneImage
GET {{baseUrl}}/images/{{imageUuid}}
Authorization: Bearer {{userToken}}

### Find all images (public - requires auth in this project)
# @name findAllImages
GET {{baseUrl}}/images
Authorization: Bearer {{userToken}}

### Find all images owned
# @name findAllImagesOwned
GET {{baseUrl}}/images/me
Authorization: Bearer {{userToken}}

### Delete image (owned)
# @name deleteImage
DELETE {{baseUrl}}/images/{{imageUuid}}
Authorization: Bearer {{userToken}}


# ==================================================
# ADMIN - user management, posts, images
# ==================================================

### Admin: list users (requires admin role)
# @name adminListUsers
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### Admin: block user (success)
# @name adminBlockUser
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/block
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "{{adminPasswordForTesting}}"
}

### Admin: unblock user (success)
# @name adminUnblockUser
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/unblock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "{{adminPasswordForTesting}}"
}

### Admin: block already blocked user (edge case)
# @name adminBlockAlreadyBlocked
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/block
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "{{adminPasswordForTesting}}"
}

### Admin: promote user to admin (requires password confirm)
# @name adminPromoteUser
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/promote
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "{{adminPasswordForTesting}}"
}

### Admin: demote admin (requires password confirm)
# @name adminDemoteUser
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/demote
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "password": "{{adminPasswordForTesting}}"
}

### Admin: remove user (soft delete)
# @name adminDeleteUser
DELETE {{baseUrl}}/admin/users/{{targetUserId}}
Authorization: Bearer {{adminToken}}


# ==================================================
# Validation / Authorization negative tests (examples)
# ==================================================

### Access protected route without token (should be 401/403)
# @name readOneUserNoAuth
GET {{baseUrl}}/user/me

### Attempt admin action with normal user (should be 403)
# @name normalUserTryBlock
PATCH {{baseUrl}}/admin/users/{{targetUserId}}/block
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "password": "{{userPasswordForTesting}}"
}

### Login with wrong password (should be 401)
# @name loginWrongPassword
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmailForTesting}}",
  "password": "wrongpassword"
}

### Login blocked user (should be 401)
# @name loginBlockedUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "blocked@example.com",
  "password": "whatever"
}


# ==================================================
# Helpers / Preparation
# ==================================================

### Prepare: create another user to act as target (captures targetUserId)
# @name prepareCreateTargetUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "Target User",
  "email": "{{targetUserEmailForTesting}}",
  "password": "{{targetUserPasswordForTesting}}"
}

### Prepare: login created target user (if needed)
# @name prepareLoginTarget
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{targetUserEmailForTesting}}",
  "password": "{{targetUserPasswordForTesting}}"
}
# Notes
# - Destructive requests (delete/block/unblock) are placed in ADMIN/DESTRUCTIVE sections and should be executed last.
# - The REST Client supports referencing previous response bodies by name ({{requestName.response.body.field}}).
# - If the backend only sets an httpOnly cookie for auth, either set @userToken/@adminToken manually or change the backend to return the token in the response body.
# ==================================================

# ==================================================
# ADMIN - posts and images (additional tests)
# ==================================================

### Admin: list posts (requires admin role)
# @name adminListPosts
GET {{baseUrl}}/admin/posts
Authorization: Bearer {{adminToken}}

### Admin: restore post (success)
# @name adminRestorePost
PATCH {{baseUrl}}/admin/posts/{{targetPostId}}/restore
Authorization: Bearer {{adminToken}}

### Admin: delete post by admin
# @name adminDeletePost
DELETE {{baseUrl}}/admin/posts/{{targetPostId}}
Authorization: Bearer {{adminToken}}


### Admin: list all images (admin)
# @name adminListImages
GET {{baseUrl}}/admin/image
Authorization: Bearer {{adminToken}}

### Admin: restore image
# @name adminRestoreImage
PATCH {{baseUrl}}/admin/image/{{targetImageId}}/restore
Authorization: Bearer {{adminToken}}

### Admin: delete image by admin
# @name adminDeleteImage
DELETE {{baseUrl}}/admin/image/{{targetImageId}}
Authorization: Bearer {{adminToken}}
